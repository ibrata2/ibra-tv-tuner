<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.ibra.tuner.launcher"
    android:versionCode="2"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- A launcher must see every launchable app (Android 11+ package visibility). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Weather, posters, football (HTTPS GET only) and the Wi-Fi/Ethernet icon. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional "use device location" for city; asked only when the user picks it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional prayer alert survives a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Uninstall" in the all-apps menu (the system asks the user to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Self-update from the project's GitHub release (Android asks the user to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:largeHeap="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AllAppsActivity" android:exported="false" android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustNothing" />
        <activity android:name=".SearchActivity" android:exported="false" android:screenOrientation="landscape"
            android:windowSoftInputMode="stateVisible|adjustNothing" />
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustNothing" />
        <activity android:name=".PrayerAlertActivity" android:exported="false" android:screenOrientation="landscape"
            android:excludeFromRecents="true" android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar.TranslucentDecor" />

        <!-- Prayer alarm (explicit PendingIntent only). -->
        <receiver android:name=".PrayerAlarm" android:exported="false" />
        <!-- Reschedules the prayer alarm after boot / clock changes. Does nothing else. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Settings from the Windows app / phone installer. Guarded by DUMP: adb shell has it, normal apps do not. -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="tv.ibra.tuner.APPLY_CONFIG" />
            </intent-filter>
        </receiver>
        <!-- Result of a self-update install session (explicit PendingIntent only). -->
        <receiver android:name="tv.ibra.common.Updater$UpdateReceiver" android:exported="false" />
    </application>
</manifest>
