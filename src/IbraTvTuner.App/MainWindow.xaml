<Window x:Class="IbraTvTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IbraTvTuner.App"
        Title="IBRA TV Tuner" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        Icon="pack://application:,,,/Assets/ibra-tv-tuner.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13.5"
        FlowDirection="{Binding Flow, Source={x:Static local:Loc.I}}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <Border Grid.Column="0" Background="#0D1426" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18">
                    <Image Source="pack://application:,,,/Assets/ibra-tv-tuner.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="IBRA TV Tuner" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding [Tagline], Source={x:Static local:Loc.I}}" Style="{StaticResource Hint}" Margin="0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <RadioButton DockPanel.Dock="Top" x:Name="NavDevices" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Checked="Nav_Checked" Tag="devices">
                    <TextBlock Text="{Binding [NavDevices], Source={x:Static local:Loc.I}}"/>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked" Tag="appearance">
                    <TextBlock Text="{Binding [NavAppearance], Source={x:Static local:Loc.I}}"/>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked" Tag="apps">
                    <TextBlock Text="{Binding [NavApps], Source={x:Static local:Loc.I}}"/>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked" Tag="changes">
                    <TextBlock Text="{Binding [NavChanges], Source={x:Static local:Loc.I}}"/>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked" Tag="compat">
                    <TextBlock Text="{Binding [NavCompat], Source={x:Static local:Loc.I}}"/>
                </RadioButton>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Click="Lang_Click" Content="{Binding [Language], Source={x:Static local:Loc.I}}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [Credit], Source={x:Static local:Loc.I}}" Style="{StaticResource Hint}" FontSize="11"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11" FlowDirection="LeftToRight">
                        <Hyperlink NavigateUri="https://t.me/ibraprogram" RequestNavigate="Link_Navigate" Foreground="{StaticResource Accent}">t.me/ibraprogram</Hyperlink>
                        ·
                        <Hyperlink NavigateUri="https://www.tiktok.com/@ibraprogram" RequestNavigate="Link_Navigate" Foreground="{StaticResource Accent}">TikTok @ibraprogram</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" FontSize="11" FlowDirection="LeftToRight"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#0F1830" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
                <DockPanel>
                    <TextBlock Text="{Binding [Target], Source={x:Static local:Loc.I}}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DeviceCombo" Width="380" Margin="0" SelectionChanged="DeviceCombo_SelectionChanged" DisplayMemberPath="Display"/>
                    <TextBlock x:Name="PlatformText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Accent}"/>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0"/>
        </Grid>
    </Grid>
</Window>
