<Window x:Class="IbraTvTuner.App.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IbraTvTuner.App"
        Title="{Binding [AddDevice], Source={x:Static local:Loc.I}}" Width="760" Height="640"
        Icon="pack://application:,,,/Assets/ibra-tv-tuner.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13.5"
        FlowDirection="{Binding Flow, Source={x:Static local:Loc.I}}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,8" Foreground="{StaticResource Warn}"/>
            <Button IsCancel="True" Content="{Binding [Cancel], Source={x:Static local:Loc.I}}"/>
        </StackPanel>
        <TabControl x:Name="Tabs" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}">
            <!-- network -->
            <TabItem Header="{Binding [TabNetwork], Source={x:Static local:Loc.I}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [StepsNetwork], Source={x:Static local:Loc.I}}" FontSize="13"/>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Width="240"><Label Content="{Binding [Host], Source={x:Static local:Loc.I}}"/><TextBox x:Name="NetHost" FlowDirection="LeftToRight"/></StackPanel>
                            <StackPanel Width="110"><Label Content="{Binding [Port], Source={x:Static local:Loc.I}}"/><TextBox x:Name="NetPort" Text="5555" FlowDirection="LeftToRight"/></StackPanel>
                        </WrapPanel>
                        <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="AddNetwork_Click" Content="{Binding [AddAndConnect], Source={x:Static local:Loc.I}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- wireless debugging -->
            <TabItem Header="{Binding [TabWireless], Source={x:Static local:Loc.I}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [StepsWireless], Source={x:Static local:Loc.I}}" FontSize="13"/>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Width="220"><Label Content="{Binding [Host], Source={x:Static local:Loc.I}}"/><TextBox x:Name="WHost" FlowDirection="LeftToRight"/></StackPanel>
                        </WrapPanel>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,8">
                            <WrapPanel>
                                <StackPanel Width="200"><Label Content="{Binding [PairPort], Source={x:Static local:Loc.I}}"/><TextBox x:Name="WPairPort" FlowDirection="LeftToRight"/></StackPanel>
                                <StackPanel Width="200"><Label Content="{Binding [PairCode], Source={x:Static local:Loc.I}}"/><PasswordBox x:Name="WCode" MaxLength="6" FlowDirection="LeftToRight"/></StackPanel>
                            </WrapPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <StackPanel Width="200" HorizontalAlignment="Left"><Label Content="{Binding [ConnectPort], Source={x:Static local:Loc.I}}"/><TextBox x:Name="WConnPort" FlowDirection="LeftToRight"/></StackPanel>
                        </Border>
                        <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="PairConnect_Click" Content="{Binding [PairAndConnect], Source={x:Static local:Loc.I}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- usb -->
            <TabItem Header="{Binding [TabUsb], Source={x:Static local:Loc.I}}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding [StepsUsb], Source={x:Static local:Loc.I}}" FontSize="13"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Click="RefreshUsb_Click" Content="{Binding [RefreshUsb], Source={x:Static local:Loc.I}}"/>
                        <Button Style="{StaticResource Primary}" Click="UseUsb_Click" Content="{Binding [UseThis], Source={x:Static local:Loc.I}}"/>
                    </StackPanel>
                    <ListBox x:Name="UsbList" FlowDirection="LeftToRight" DisplayMemberPath="Display"/>
                </DockPanel>
            </TabItem>

            <!-- discover -->
            <TabItem Header="{Binding [TabDiscover], Source={x:Static local:Loc.I}}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding [StepsDiscover], Source={x:Static local:Loc.I}}" FontSize="13"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ScanBtn" Click="Scan_Click" Content="{Binding [Scan], Source={x:Static local:Loc.I}}"/>
                        <Button Style="{StaticResource Primary}" Click="UseFound_Click" Content="{Binding [UseThis], Source={x:Static local:Loc.I}}"/>
                        <ProgressBar x:Name="ScanProgress" Width="180" Height="8" Margin="8,0,0,8" Maximum="100"/>
                    </StackPanel>
                    <ListBox x:Name="FoundList" FlowDirection="LeftToRight" DisplayMemberPath="Display"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
