<Window x:Class="IbraTvTuner.App.PlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IbraTvTuner.App"
        Title="{Binding [Plan], Source={x:Static local:Loc.I}}" Width="900" Height="560"
        Icon="pack://application:,,,/Assets/ibra-tv-tuner.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13.5"
        FlowDirection="{Binding Flow, Source={x:Static local:Loc.I}}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="{Binding [Plan], Source={x:Static local:Loc.I}}"/>
        <TextBlock DockPanel.Dock="Top" x:Name="TargetText" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApplyBtn" Style="{StaticResource Primary}" Click="Apply_Click" Content="{Binding [Apply], Source={x:Static local:Loc.I}}"/>
            <Button IsCancel="True" Content="{Binding [Cancel], Source={x:Static local:Loc.I}}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="NoteText" Style="{StaticResource Hint}"/>
        <ItemsControl DockPanel.Dock="Bottom" x:Name="IssuesList" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Foreground="{StaticResource Warn}" Text="{Binding}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DataGrid x:Name="ItemsGrid" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="CPkg" Binding="{Binding Package}" Width="2*"/>
                <DataGridTextColumn x:Name="CBefore" Binding="{Binding Before}" Width="110"/>
                <DataGridTextColumn x:Name="CChange" Binding="{Binding Change}" Width="150"/>
                <DataGridTextColumn x:Name="CReason" Binding="{Binding Reason}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
