<UserControl x:Class="IbraTvTuner.App.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IbraTvTuner.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding [NavDevices], Source={x:Static local:Loc.I}}"/>

            <!-- ADB -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="{Binding [AdbPath], Source={x:Static local:Loc.I}}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="DownloadAdb_Click" Content="{Binding [DownloadAdb], Source={x:Static local:Loc.I}}"/>
                        <Button DockPanel.Dock="Right" Click="BrowseAdb_Click" Content="{Binding [Browse], Source={x:Static local:Loc.I}}"/>
                        <TextBox x:Name="AdbPathBox" IsReadOnly="True" FlowDirection="LeftToRight"/>
                    </DockPanel>
                    <TextBlock x:Name="AdbStatus" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- list -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Click="Add_Click"
                                Content="{Binding [AddDevice], Source={x:Static local:Loc.I}}"/>
                        <ListBox x:Name="DeviceList" MinHeight="260" SelectionChanged="DeviceList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding Profile.Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Hint}" Margin="0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- details -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="Details" IsEnabled="False">
                            <WrapPanel>
                                <StackPanel Width="240" Margin="0,0,12,0">
                                    <Label Content="{Binding [Nickname], Source={x:Static local:Loc.I}}"/>
                                    <TextBox x:Name="NickBox"/>
                                </StackPanel>
                                <StackPanel Width="180">
                                    <Label Content="{Binding [Role], Source={x:Static local:Loc.I}}"/>
                                    <ComboBox x:Name="RoleCombo"/>
                                </StackPanel>
                                <Button VerticalAlignment="Bottom" Click="SaveDevice_Click" Content="{Binding [Save], Source={x:Static local:Loc.I}}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [RoleHint], Source={x:Static local:Loc.I}}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource Primary}" Click="Connect_Click" Content="{Binding [Connect], Source={x:Static local:Loc.I}}"/>
                                <Button Click="ReadInfo_Click" Content="{Binding [ReadInfo], Source={x:Static local:Loc.I}}"/>
                                <Button Style="{StaticResource DangerBtn}" Click="Remove_Click" Content="{Binding [Remove], Source={x:Static local:Loc.I}}"/>
                            </WrapPanel>
                            <TextBlock x:Name="InfoText" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12.5"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4" Text="{Binding [SelfTest], Source={x:Static local:Loc.I}}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [SelfTestHint], Source={x:Static local:Loc.I}}"/>
                            <Button x:Name="SelfTestBtn" HorizontalAlignment="Left" Click="SelfTest_Click" Content="{Binding [SelfTest], Source={x:Static local:Loc.I}}"/>
                            <ItemsControl x:Name="SelfTestList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Mark}" Foreground="{Binding Brush}" FontWeight="Bold" Width="22"/>
                                            <TextBlock Text="{Binding Text}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="{Binding [Log], Source={x:Static local:Loc.I}}"/>
                    <TextBox x:Name="LogBox" Height="170" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
