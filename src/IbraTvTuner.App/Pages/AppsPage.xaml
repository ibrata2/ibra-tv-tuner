<UserControl x:Class="IbraTvTuner.App.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IbraTvTuner.App">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [NavApps], Source={x:Static local:Loc.I}}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <Button Style="{StaticResource Primary}" Click="Refresh_Click" Content="{Binding [Refresh], Source={x:Static local:Loc.I}}" VerticalAlignment="Bottom"/>
                <StackPanel Margin="8,0">
                    <Label Content="{Binding [ModelList], Source={x:Static local:Loc.I}}"/>
                    <ComboBox x:Name="ModelCombo" Width="360" DisplayMemberPath="Display" SelectionChanged="ModelCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="{Binding [ShowClass], Source={x:Static local:Loc.I}}"/>
                    <ComboBox x:Name="ClassCombo" Width="150" SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="{Binding [Search], Source={x:Static local:Loc.I}}"/>
                    <TextBox x:Name="SearchBox" Width="200" FlowDirection="LeftToRight" TextChanged="Filter_Changed"/>
                </StackPanel>
                <TextBlock x:Name="CountText" VerticalAlignment="Bottom" Margin="8,0,0,12" Foreground="{StaticResource Muted}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="AppGrid" Grid.Row="2" SelectionMode="Extended" CanUserSortColumns="True" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                <DataGridTextColumn x:Name="ColPackage" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColKind" Binding="{Binding KindText}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColState" Binding="{Binding StateText}" Width="90" IsReadOnly="True"/>
                <DataGridTemplateColumn x:Name="ColClass" Width="110" SortMemberPath="ClassText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ClassText}" Foreground="{Binding ClassBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColReason" Binding="{Binding Reason}" Width="3*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,12">
            <StackPanel>
                <TextBlock x:Name="TargetText" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Style="{StaticResource Primary}" Click="Disable_Click" Content="{Binding [DisableSelected], Source={x:Static local:Loc.I}}"/>
                    <Button Click="Enable_Click" Content="{Binding [EnableSelected], Source={x:Static local:Loc.I}}"/>
                    <Button Style="{StaticResource DangerBtn}" Click="Uninstall_Click" Content="{Binding [UninstallSelected], Source={x:Static local:Loc.I}}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4" Text="{Binding [Measure], Source={x:Static local:Loc.I}}"/>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding [MeasureNote], Source={x:Static local:Loc.I}}"/>
                <WrapPanel>
                    <TextBox x:Name="MeasureLabel" Width="120" Text="before" FlowDirection="LeftToRight"/>
                    <Button Click="MeasureHome_Click" Content="{Binding [MeasureHome], Source={x:Static local:Loc.I}}"/>
                    <ComboBox x:Name="AppCombo" Width="300" FlowDirection="LeftToRight"/>
                    <Button Click="MeasureApp_Click" Content="{Binding [MeasureApp], Source={x:Static local:Loc.I}}"/>
                </WrapPanel>
                <TextBox x:Name="MeasureOut" Height="90" IsReadOnly="True" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
