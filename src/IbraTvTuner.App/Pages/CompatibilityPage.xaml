<UserControl x:Class="IbraTvTuner.App.Pages.CompatibilityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IbraTvTuner.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding [NavCompat], Source={x:Static local:Loc.I}}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding [CompatHint], Source={x:Static local:Loc.I}}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}">
                <Grid x:Name="Matrix"/>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="Notes"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
