<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IbraTvTuner.App</RootNamespace>
    <AssemblyName>IbraTvTuner</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\ibra-tv-tuner.ico</ApplicationIcon>
    <Product>IBRA TV Tuner</Product>
    <Company>IBRAPROGRAM</Company>
    <Authors>إبراهيم الخزرجي</Authors>
    <Copyright>© 2026 إبراهيم الخزرجي — IBRAPROGRAM</Copyright>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IbraTvTuner.Core\IbraTvTuner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon\ibra-tv-tuner.ico" Link="Assets\ibra-tv-tuner.ico" />
    <Resource Include="..\..\assets\icon\ibra-tv-tuner-1024.png" Link="Assets\ibra-tv-tuner.png" />
    <!-- Built by android/build.sh before publishing. -->
    <EmbeddedResource Include="..\..\android\out\ibra-tv-launcher.apk" LogicalName="ibra-tv-launcher.apk" Condition="Exists('..\..\android\out\ibra-tv-launcher.apk')" />
    <EmbeddedResource Include="..\..\android\out\ibra-tv-testapp.apk" LogicalName="ibra-tv-testapp.apk" Condition="Exists('..\..\android\out\ibra-tv-testapp.apk')" />
  </ItemGroup>

</Project>
